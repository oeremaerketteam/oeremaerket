---
import "../styles/index.css"
import PageLayout from "../layouts/PageLayout.astro"
import HeroCarousel from "../components/HeroCarousel.astro";
import InfoCard from "../components/InfoCard.astro";
import DonationCounter from "../components/DonationCounter.astro";
const cards = [
  {
    title: "Vores donationer",
    text: "Følg med i vores donationer til Den Danske Naturfond",
    href: "/donationer",
  },
  {
    title: "Vores proces",
    text: "Hver gang du bruger dit Dankort, donerer vi til Den Danske Naturfond.",
    href: "/fordele",
  },
  {
    title: "Vores korttyper",
    text: "Find det Dankort, der passer til dig til klassisk hverdagskort til andre løsninger",
    href: "/korttyper",
  },
];
---

<PageLayout>
  <HeroCarousel />
    <section class="info-cards">
 {cards.map((card) => (
      <InfoCard {...card} />
    ))}
  </section>
  <DonationCounter />
 <section class="green-card-section">
  <div class="green-card-wrapper">
    <img
      class="green-card-img"
      src="/imgs/dankortGreen.webp"
      alt="Dankort Green"
      width="500"
      height="300"
      loading="lazy"
      decoding="async"
    />

    <div class="green-card-overlay"></div>
  </div>

  <div class="green-card-content">
    <h2>Har du hørt om Dankort Green?</h2>

    <p>
      Dankort Green er et bæredygtigt betalingskort lavet af 100%
      genbrugsmateriale. Med kortet doneres der automatisk 5% mere til grønne
      initiativer.
    </p>

    <a href="/korttyper" class="green-card-link">
      Læs mere om vores korttyper her
    </a>
  </div>
</section>
</PageLayout>
<div class="exam-popup" data-popup>
  <div class="exam-popup-box">
    <h2>Bemærk</h2>

    <p>
       Dette projekt er udarbejdet som led i en eksamen på Erhvervsakademi København og i samarbejde med 1508, hvor Dankort udelukkende fungerer som case-virksomhed. Projektet er dermed fiktivt og ikke bestilt af eller udarbejdet på vegne af Dankort.
    </p>
	
    <p>
       Vi gør ikke krav på ejerskab af de anvendte billeder og visuelle materialer.
  Alt billedmateriale tilhører de respektive rettighedshavere og er hentet fra:
  naturfonden.dk, dankort.dk, pexels.com samt
  samvirke.dk/artikler/dankortets-historie.
    </p>

    <button type="button" data-close-popup>Jeg forstår</button>
  </div>
</div>
<script>
  const popup = document.querySelector("[data-popup]");
  const closeButton = document.querySelector("[data-close-popup]");

  const hasSeenPopup = sessionStorage.getItem("examPopupSeen");

  if (hasSeenPopup) {
    popup?.classList.add("is-hidden");
  }

  closeButton?.addEventListener("click", () => {
    popup?.classList.add("is-hidden");
    sessionStorage.setItem("examPopupSeen", "true");
  });
</script>

