---
import "../styles/korttyper.css";
import PageLayout from "../layouts/PageLayout.astro";
import KortCard from "../components/KortCard.astro";

const hero = "/imgs/korthero.webp";
const premium = "/imgs/dankortPremium.webp";
const regular = "/imgs/dankortRegular.webp";
const green = "/imgs/dankortGreen.webp";
const ung = "/imgs/dankortUNG.webp";
---

<PageLayout title="korttyper">
  <main class="kort-page">
    <section class="kort-hero">
      <img src={hero} alt="Betal med Dankort" width="900" height="500" />
      <h1>Dankorts korttyper</h1>
    </section>

    <section class="cards">
      <KortCard
        title="Premium"
        billede={premium}
        text="Dankort Premium giver dig eksklusive tilbud, ekstra fordele og unikke rabatter. Samtidig donerer du 10% mere til den danske natur end med Dankort Regular, og kan personliggøre dit kort med eget design."
      />

      <KortCard
        title="Regular"
        billede={regular}
        text="Dankort Regular er det klassiske betalingskort til hverdagen. Med sikre og enkle betalinger får du stadig adgang til gode fordele og rabatter – samtidig med at 1 øre doneres til Den Danske Naturfond ved hver betaling."
        reverse={true}
      />

      <KortCard
        title="Green"
        billede={green}
        text="Dankort Green er et bæredygtigt betalingskort lavet af 100% genbrugsmaterialer. Du får adgang til grønne fordele og rabatter, samtidig med at du donerer 10% mere til den danske natur end med Dankort Regular."
      />
      <KortCard
        title="Ung"
        billede={ung}
        text="Dankort Young er betalingskortet til unge under 18 år med sikre og enkle betalinger i hverdagen. Kortet giver adgang til særlige fordele og rabatter for unge, samtidig med at hver betaling støtter den danske natur."
        reverse={true}
      />
    </section>
  </main>
</PageLayout>
