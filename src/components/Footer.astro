---
import "../styles/general.css"
---

<footer>
  <a href="/" class="logo" aria-label="Gå til forsiden">
    <img src="/imgs/logo-small.webp" class="logopic" alt="Dankort Logo" width="90" height="60"/>
  </a>
  <div class="grid_footer">
    <div>
      <h4>Genveje</h4>
      <nav>
        <ul>
          <li><a href="/donationer">Donationer</a></li>
          <li><a href="/proces">Proces</a></li>
          <li><a href="/korttyper">Korttyper</a></li>
        </ul>
      </nav>
    </div>
    <div>
      <h4>Praktisk information</h4>
      <nav>
        <ul>
          <li><a href="/om">Om os</a></li>
          <li><a href="/kontakt">Kontakt</a></li>
          <li><a href="">Tlf: +45 89 87 95 80</a></li>
        </ul>
      </nav>
    </div>
    <div>
      <h4>Sociale Medier</h4>
      <nav>
        <ul>
          <li><a href="https://www.facebook.com/dankort.danmark">Facebook</a></li>
          <li><a href="https://www.linkedin.com/showcase/dankort/?originalSubdomain=dk">LinkedIn</a></li>
          <li><a href="https://www.instagram.com/dankort.danmark/">Instagram</a></li>
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  footer {
    background-color: #e21e26;
  }
  .grid_footer {
    display: flex;
    justify-content: space-around;
    padding-bottom: 1rem;
  }
  li {
    list-style: none;
  }
  h4 {
    color: #f5f5f5;
    padding-top: 1rem;
  }
  div a {
    color: #f5f5f5;
  }
  .logopic {
    max-width: 60px;
    display: flex;
    place-self: center;
    padding-top: 1rem;
  }
  @media (min-width: 768px){
    .logopic {
      max-width: 90px;
    }
    h4{
      font-size: 1.5rem;
    }
    div a{
      font-size: 1.2rem;
    }
  }
</style>
