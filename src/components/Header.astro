	---

const navItems = [
  { name: "Forside", href: "/index" },
  { name: "Donationer", href: "/donationer" },
  { name: "Proces", href: "/proces" },
  { name: "Korttyper", href: "/korttyper" },
  
];
---
    <header class="site-header">
			<a href="/" class="logo" aria-label="Gå til forsiden">
				<img src="/imgs/DK_Logo_CMYK.png" alt="Dankort Logo" />
			</a>
		
  <button class="menu-toggle" aria-label="Åbn menu" aria-expanded="false">
    <span></span>
    <span></span>
    <span></span>
  </button>
			<nav id="main-nav" class="main-nav" aria-label="Hovedmenu">
				<ul>
      {navItems.map((item) => (
        <li>
          <a href={item.href}>{item.name}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
<script>
  const button = document.querySelector(".menu-toggle");
  const nav = document.querySelector(".main-nav");

  button?.addEventListener("click", () => {
    nav?.classList.toggle("is-open");

    const isOpen = nav?.classList.contains("is-open");
    button.setAttribute("aria-expanded", String(isOpen));
  });
</script>
<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background-color: #f5f5f5;
    position: relative;
  }

  .logo img {
    width: 70px;
    height: auto;
    display: block;
  }

  .menu-toggle {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    background: none;
    border: none;
    cursor: pointer;
  }

  .menu-toggle span {
    width: 36px;
    height: 4px;
    background-color: #E21E26;
    border-radius: 999px;
    display: block;
  }

  .main-nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background-color: #E21E26;
    padding: 1rem 1.5rem;
  }

  .main-nav.is-open {
    display: block;
  }

  .main-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .main-nav li {
    margin-bottom: 1rem;
  }

  .main-nav a {
    text-decoration: underline;
    color: #ebebeb;
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .menu-toggle {
      display: none;
    }

    .main-nav {
      display: block;
      position: static;
      width: auto;
      padding: 0;
      background: none;
    }

    .main-nav ul {
      display: flex;
      gap: 2rem;
    }

    .main-nav li {
      margin-bottom: 0;
    }
  }
</style>