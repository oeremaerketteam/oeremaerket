	---

const navItems = [
  { name: "Forside", href: "/index" },
  { name: "Donationer", href: "/donationer" },
  { name: "Proces", href: "/proces" },
  { name: "Korttyper", href: "/korttyper" },
  
];
---
    <header class="site-header">
			<a href="/" class="logo" aria-label="Gå til forsiden">
				<img src="/imgs/DK_Logo_CMYK.png" alt="Dankort Logo" />
			</a>
		
  <button class="menu-toggle" aria-label="Åbn menu" aria-expanded="false">
    <span></span>
    <span></span>
    <span></span>
  </button>
			<nav id="main-nav" class="main-nav" aria-label="Hovedmenu">
				<ul>
      {navItems.map((item) => (
        <li>
          <a href={item.href}>{item.name}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
<script>
 const button = document.querySelector(".menu-toggle");
const nav = document.querySelector(".main-nav");

button?.addEventListener("click", () => {
  nav?.classList.toggle("is-open");
  button.classList.toggle("is-active");

  const isOpen = nav?.classList.contains("is-open");
  button.setAttribute("aria-expanded", String(isOpen));
});
</script>
<style>
 .site-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.75rem 1.5rem;
  background-color: #f5f5f5;
  position: relative;
  z-index: 1000;
}

  .logo img {
    width: 70px;
    height: auto;
    display: block;
  }

  .menu-toggle {
     position: relative;
  width: 44px;
  height: 33px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  }

  .menu-toggle span {
    position: absolute;
  left: 0;
  width: 44px;
  height: 4px;
  background-color: #e21e26;
  border-radius: 999px;
  transition:
    top 0.2s ease,
    transform 0.6s cubic-bezier(0.68, -0.55, 0.27, 1.55),
    opacity 0.2s ease;
  }
.menu-toggle span:nth-child(1) {
  top: 0;
}

.menu-toggle span:nth-child(2) {
  top: 50%;
  transform: translateY(-50%);
}

.menu-toggle span:nth-child(3) {
  top: 100%;
  transform: translateY(-100%);
}

.menu-toggle.is-active span:nth-child(1) {
  top: 50%;
  transform: translateY(-50%) rotate(45deg);
}

.menu-toggle.is-active span:nth-child(2) {
  opacity: 0;
}

.menu-toggle.is-active span:nth-child(3) {
  top: 50%;
  transform: translateY(-50%) rotate(-45deg);
}
.main-nav {
  position: absolute;
  top: 100%;
  left: 0;

  width: 100%;

  background-color: #e21e26;

  padding: 0 1.5rem;

  max-height: 0;
  overflow: hidden;

  opacity: 0;

  transform: translateY(-10px);

  transition:
    max-height 0.5s ease,
    opacity 0.35s ease,
    transform 0.35s ease,
    padding 0.35s ease;

  z-index: 1001;
}

 .main-nav.is-open {
  max-height: 400px;
  opacity: 1;
  transform: translateY(0);

  padding: 1rem 1.5rem;
}

  .main-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .main-nav li {
    margin-bottom: 1rem;
  }

  .main-nav a {
    text-decoration: underline;
    color: #ebebeb;
    font-weight: 600;
    font-size: 1.5rem;
  }

  @media (min-width: 768px) {
    .menu-toggle {
      display: none;
    }

    .main-nav {
      display: block;
      position: static;
      width: auto;
      padding: 0;
      background: none;
    }

    .main-nav ul {
      display: flex;
      gap: 2rem;
    }

    .main-nav li {
      margin-bottom: 0;
    }
  }
</style>