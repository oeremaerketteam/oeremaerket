---
import { Image } from "astro:assets";
const { title, text, text2, plakat, order } = Astro.props;
---

<section class="grid_plakat">
  <div class="phototext">
    <Image src={plakat} alt="plakat" class="plakat" />
  </div>
  <div class="content">
    <h2>{title}</h2>
    <p>{text}</p>
    <p>{text2}</p>
  </div>
</section>

<style define:vars={{ order }}>
  .plakat {
    max-width: 100%;
    width: 350px;
    height: auto;
  }
  .content {
    /* place-content: center; */
    text-align: left;

    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    margin: 2rem;
  }
  .phototext {
    place-self: center;
    margin: 0;
  }
  h2 {
    color: #e21e26;
    font-size: 40px;
    font-weight: bold;
  }
  p {
    font-size: 16px;
  }
  @media screen and (width>800px) {
    .grid_plakat {
      display: grid;
      grid-template-columns: 1fr 1fr;
      margin: 2rem;
    }
    .content {
      order: var(--order);
    }
    .plakat {
      width: 450px;
      height: auto;
    }
  }
</style>
